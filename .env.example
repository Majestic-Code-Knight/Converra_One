# =========================================================
# Converra One - Environment Configuration Example
# Tagline: Where Conversations Converge.
# =========================================================

# Application & Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_NAME=Converra_One
APP_VERSION=1.0.0

# NitroStack Cloud & Local MCP Configuration
NITROSTACK_API_KEY=your_nitrostack_api_key_here
NITROSTACK_PROJECT_ID=converra_one_prod
NITROSTACK_SERVER_NAME=converra-one-mcp

# OpenAI Integration (Future Phases)
OPENAI_API_KEY=sk-placeholder-openai-api-key
OPENAI_MODEL=gpt-4o

# Supabase Storage & Database (Future Phases)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth & Gmail/Calendar Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Slack Workspace Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Discord Integration
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_personal_access_token
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Notion Integration
NOTION_API_KEY=secret_your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id
